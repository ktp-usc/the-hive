# Sanity — required for app + Studio (see sanity/env.ts)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Sanity — optional; used by defineLive / sanityFetch (see sanity/lib/live.ts)
# Use Viewer-scoped tokens for the site; Contributor only if server preview needs draft access.
SANITY_API_READ_TOKEN=
SANITY_API_VIEWER_TOKEN=

# Resend — transactional email (see lib/resend.ts)
RESEND_API_KEY=
